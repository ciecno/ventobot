# ==============================================================
# إعدادات توكنات بوت ديسكورد وموقع LZT Market
# ==============================================================

# 1. توكن بوت الديسكورد (Discord Bot Token)
# يمكنك الحصول عليه من: https://discord.com/developers/applications
# أنشئ تطبيقاً جديداً ثم اذهب إلى قسم "Bot" وانسخ الـ Token
# وتأكد من تفعيل صلاحيات Privileged Gateway Intents (Message Content Intent)
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 2. توكن موقع LZT Market API (Bearer Token)
# يمكنك الحصول عليه من حسابك في موقع LZT: https://lzt.market/account/api
LZT_API_TOKEN=YOUR_LZT_API_TOKEN_HERE
